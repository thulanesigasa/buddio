# Buddio Configuration
PORT=3000
NODE_ENV=development

# Target LMS Default
LMS_URL=https://lms.uj.ac.za/login/index.php

# AI Configuration (Optional: system provides built-in heuristic retrieval fallback if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini

# Playwright Browser Options
HEADLESS=false
BROWSER_SLOWMO_MS=150
AUTO_PILOT_DELAY_MS=2500
